tool="$(basename "$0")"
quiet=""
mode="get"
audio=false
video=false
state=""

usage() {
  printf "Usage: %s [-ahmqt] [[-AV] state]\n" "$tool"
}

# require root
if [ "$(id -u)" -ne 0 ] ; then
  printf "%s: need root privileges!\n" "$tool" && exit 1
fi

# parse argument
while getopts aAhmqtV arg ; do
  case "$arg" in
    a)
      mode="get"
      ;;
    A)
      audio=true
      ;;
    h)
      usage && exit
      ;;
    m)
      mode="monitor"
      ;;
    q)
      quiet="-q"
      ;;
    t)
      mode="toggle"
      ;;
    V)
      video=true
      ;;
    ?)
      usage && exit 2
      ;;
  esac
done
shift $((OPTIND - 1))
[ $# -gt 1 ] && usage && exit 2
case "$1" in
  1|yes|on|enable)
    state=1
    mode="set"
    ;;
  0|no|off|disable)
    state=0
    mode="set"
    ;;
  "")
    [ "$mode" = "set" ] && printf "%s: no state specified!\n" "$tool" && usage && exit 2
    ;;
  *)
    usage && exit 2
    ;;
esac

# default to applying record state to both audio & video if neither was explicitly specified
if ! $audio && ! $video ; then
  audio=true
  video=true
fi

case "$mode" in
  get)
    $audio && sysctl kern.audio.record
    $video && sysctl kern.video.record
    ;;
  set)
    $audio && sysctl $quiet kern.audio.record="$state"
    $video && sysctl $quiet kern.video.record="$state"
    ;;
  toggle)
    $audio && sysctl $quiet kern.audio.record="$(( ! $(sysctl -n kern.audio.record) ))"
    $video && sysctl $quiet kern.video.record="$(( ! $(sysctl -n kern.video.record) ))"
    ;;
  monitor)
    printf "%s: Not yet implemented! Exiting.\n" "$tool" && exit
    ;;
esac
