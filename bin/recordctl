tool="$(basename "$0")"
quiet=false
no_name=false
mode="get"

usage() {
  printf "Usage: %s [-adhmnqt] [name[=value]]\n" "$tool"
}

validate_var() {
  _valid=false
  case "$1" in
    "record.audio"|"record.video")
      _valid=true
      ;;
  esac
  $_valid
}

validate_value() {
  _valid=false
  case "$1" in
    0|1|!) _valid=true ;;
  esac
  $_valid
}

# @param _var [String] the name of the variable to get the value for
# @param _no_name ["true", "false"] (optional) whether to output the variable name with the value (default: "true")
get_var() {
  [ -z "$1" ] && usage && exit 2

  _var="$1"
  _no_name=false

  [ -n "$2" ] && _no_name="$2"

  case "$_var" in
    record.*)
      _input="${_var##*.}"
      ! $_no_name && printf "%s=" "$_var"
      sysctl -n "kern.${_input}.record"
      ;;
    *)
      usage && exit 2
      ;;
  esac
}

# @param _var [String] the name of the variable to set the value for
# @param _value [0, 1, "!"] the value to set the variable to ("!" will toggle the current value)
# @param _quiet ["true", "false"] (optional) whether to hide all output when setting the value (default: "false")
# @param _no_name ["true", "false"] (optional) whether to output the variable name with the value (default: "true")
set_var() {
  [ -z "$1" ] && usage && exit 2
  [ -z "$2" ] && usage && exit 2

  _var="$1"
  _value="$2"
  _quiet=false
  _no_name=false

  [ -n "$3" ] && _quiet="$3"
  [ -n "$4" ] && _no_name="$4"

  case "$_var" in
    record.*)
      _input="${_var##*.}"

      # if toggling the value, get the current value and negate it (silently)
      [ "$_value" = "!" ] && _value="$(( ! $(get_var "$_var" true) ))"

      ! $_quiet && ! $_no_name && printf "%s=" "$_var"
      sysctl $($_quiet && echo "-q") -n "kern.${_input}.record=${_value}"
      ;;
    *)
      usage && exit 2
      ;;
  esac
}

# require root
if [ "$(id -u)" -ne 0 ] ; then
  printf "%s: need root privileges!\n" "$tool" && exit 1
fi

# parse argument
while getopts adhmnqt arg ; do
  case "$arg" in
    a)
      mode="get"
      ;;
    h)
      usage && exit
      ;;
    m)
      mode="monitor"
      ;;
    n)
      no_name=true
      ;;
    q)
      quiet=true
      ;;
    t)
      mode="toggle"
      ;;
    ?)
      usage && exit 2
      ;;
  esac
done
shift $((OPTIND - 1))

case "$mode" in
  toggle)
    for _name in record.audio record.video ; do
      set_var "$_name" "!" "$quiet" "$no_name"
    done
    ;;
  monitor)
    printf "%s: Not yet implemented! Exiting.\n" "$tool" && exit
    ;;
  *)
    # process any remaining commands
    if [ "$#" -gt 0 ] && [ "$mode" != "toggle" ] && [ "$mode" != "monitor" ] ; then
      while [ $# -gt 0 ] ; do
        case "$1" in
          # set variable
          *=*)
            mode="set"
            _name="${1%%=*}"
            _value="${1##*=}"
            ! validate_var "$_name" && usage && exit 2
            ! validate_value "$_value" && usage && exit 2
            set_var "$_name" "$_value" "$quiet" "$no_name"
            ;;
          # get variable
          *)
            mode="get"
            ! validate_var "$1" && usage && exit 2
            get_var "$1" "$no_name"
            ;;
        esac
        shift
      done
    else
      for _name in record.audio record.video ; do
        mode="get"
        get_var "$_name" "$no_name"
      done
    fi
    ;;
esac
