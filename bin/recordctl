# IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
# FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
# AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
# LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
# OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
# SOFTWARE.

tool="$(basename "$0")"
quiet=false
no_name=false
mode="get"
monitor_seconds=5

usage() {
  printf "Usage: %s [-adhnqt] [-m [-c seconds]] [name[=value]]\n" "$tool"
}

validate_var() {
  _valid=false
  case "$1" in
    "record.audio"|"record.video")
      _valid=true
      ;;
  esac
  $_valid
}

validate_value() {
  _valid=false
  case "$1" in
    0|1|!) _valid=true ;;
  esac
  $_valid
}

# @param _var [String] the name of the variable to get the value for
# @param _no_name ["true", "false"] (optional) whether to output the variable name with the value (default: "true")
get_var() {
  [ -z "$1" ] && usage && exit 2

  _var="$1"
  _no_name=false

  [ -n "$2" ] && _no_name="$2"

  case "$_var" in
    record.*)
      _input="${_var##*.}"
      ! $_no_name && printf "%s=" "$_var"
      sysctl -n "kern.${_input}.record"
      ;;
    *)
      usage && exit 2
      ;;
  esac
}

# @param _var [String] the name of the variable to set the value for
# @param _value [0, 1, "!"] the value to set the variable to ("!" will toggle the current value)
# @param _quiet ["true", "false"] (optional) whether to hide all output when setting the value (default: "false")
# @param _no_name ["true", "false"] (optional) whether to output the variable name with the value (default: "true")
set_var() {
  [ -z "$1" ] && usage && exit 2
  [ -z "$2" ] && usage && exit 2

  _var="$1"
  _value="$2"
  _quiet=false
  _no_name=false

  [ -n "$3" ] && _quiet="$3"
  [ -n "$4" ] && _no_name="$4"

  case "$_var" in
    record.*)
      _input="${_var##*.}"

      # if toggling the value, get the current value and negate it (silently)
      [ "$_value" = "!" ] && _value="$(( ! $(get_var "$_var" true) ))"

      ! $_quiet && ! $_no_name && printf "%s=" "$_var"
      sysctl $($_quiet && echo "-q") -n "kern.${_input}.record=${_value}"
      ;;
    *)
      usage && exit 2
      ;;
  esac
}

monitor() {
  _audio_prev="$(get_var "record.audio" true)"
  _video_prev="$(get_var "record.video" true)"
  printf "record.audio=%s\n" "$_audio_prev"
  printf "record.video=%s\n" "$_video_prev"

  while true ; do
    sleep "$monitor_seconds"

    _audio_new="$(get_var "record.audio" true)"
    _video_new="$(get_var "record.video" true)"

    if [ "$_audio_new" -ne "$_audio_prev" ] ; then
      printf "record.audio=%i\t#changed\n" "$_audio_new"
      _audio_prev="$_audio_new"
    fi
    if [ "$_video_new" -ne "$_video_prev" ] ; then
      printf "record.video=%i\t#changed\n" "$_video_new"
      _video_prev="$_video_new"
    fi
  done
}

require_root() {
  [ "$(id -u)" -ne 0 ] && printf "%s: need root privileges!\n" "$tool" && exit 1
}

# parse argument
while getopts ac:dhmnqt arg ; do
  case "$arg" in
    a)
      mode="get"
      ;;
    c)
      monitor_seconds="$OPTARG"
      ;;
    h)
      usage && exit
      ;;
    m)
      mode="monitor"
      ;;
    n)
      no_name=true
      ;;
    q)
      quiet=true
      ;;
    t)
      mode="toggle"
      ;;
    ?)
      usage && exit 2
      ;;
  esac
done
shift $((OPTIND - 1))

case "$mode" in
  toggle)
    require_root
    [ $# -gt 0 ] && printf "%s: toggling via '-t' option, so ignoring specified control(s): %s\n" "$tool" "$@" >&2

    for _name in record.audio record.video ; do
      set_var "$_name" "!" "$quiet" "$no_name"
    done
    ;;
  monitor)
    [ $# -gt 0 ] && printf "%s: monitoring state changes via '-m' option, so ignoring specified control(s): %s\n" "$tool" "$@" >&2
    monitor
    ;;
  *)
    # process any remaining commands
    if [ "$#" -gt 0 ] ; then
      while [ $# -gt 0 ] ; do
        case "$1" in
          # set control value
          *=*)
            mode="set"
            _name="${1%%=*}"
            _value="${1##*=}"

            require_root
            ! validate_var "$_name" \
              && printf "%s: unknown control name '%s'!\n" "$tool" "$_name" >&2 \
              && usage \
              && exit 2
            ! validate_value "$_value" \
              printf "%s: invalid value '%s' for control '%s'!\n" "$tool" "$_value" "$_name" >&2 \
              && usage \
              && exit 2

            set_var "$_name" "$_value" "$quiet" "$no_name"
            ;;
          # get control value
          *)
            mode="get"
            _name="${1%%=*}"

            ! validate_var "$1" \
              && printf "%s: unknown control name '%s'!\n" "$tool" "$_name" >&2 \
              && usage && exit 2

            get_var "$_name" "$no_name"
            ;;
        esac
        shift
      done
    else
      for _name in record.audio record.video ; do
        mode="get"
        get_var "$_name" "$no_name"
      done
    fi
    ;;
esac
